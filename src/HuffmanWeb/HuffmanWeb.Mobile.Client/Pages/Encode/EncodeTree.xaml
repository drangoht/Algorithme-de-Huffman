<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HuffmanWeb.Mobile.Client.Pages.Encode.EncodeTree"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Maui.ColorPicker;assembly=Maui.ColorPicker"
    xmlns:drawables="clr-namespace:HuffmanWeb.Mobile.Client.Components.BinaryTree"
    xmlns:strings="clr-namespace:HuffmanWeb.Mobile.Client.Resources.Strings"
    Title="{x:Static strings:AppResources.EncodeTreePageTitle}"
    BackgroundColor="{StaticResource Background}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            x:Name="settingsToolsBarItem"
            Clicked="settingsToolsBarItem_Clicked"
            Text="{x:Static strings:AppResources.TreeSettingsLabel}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <!-- The drawable sizes itself to the laid-out tree; the ScrollView pans it. -->
        <ScrollView x:Name="treeScroll" Orientation="Both">
            <drawables:BinaryTreeDrawable
                x:Name="binaryTree"
                BackgroundColor="Transparent"
                Graph="{Binding ViewModel.Response.Graph}"
                HorizontalOptions="Start"
                LineColor="{Binding TreeViewModel.LineColor}"
                LineTextColor="{Binding TreeViewModel.LineTextColor}"
                NodeColor="{Binding TreeViewModel.NodeColor}"
                NodeHeight="{Binding TreeViewModel.NodeHeight}"
                NodeTextColor="{Binding TreeViewModel.NodeTextColor}"
                NodeWidth="{Binding TreeViewModel.NodeWidth}"
                VerticalOptions="Start" />
        </ScrollView>

        <!-- Settings Panel (Overlay) -->
        <Border
            x:Name="settingsGrid"
            Margin="16"
            Padding="16"
            BackgroundColor="{StaticResource Surface}"
            HorizontalOptions="End"
            IsVisible="False"
            Shadow="{StaticResource Shadow}"
            Stroke="{StaticResource Gray300}"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="1"
            VerticalOptions="Start"
            WidthRequest="320">

            <VerticalStackLayout Spacing="16">
                <Label Style="{StaticResource CardTitle}" Text="Tree Settings" />

                <!-- Dimensions -->
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource LabelConfigTree}" Text="{x:Static strings:AppResources.TreeNodeWidthSettingLabel}" />
                    <Slider
                        Maximum="150"
                        Minimum="30"
                        Value="{Binding TreeViewModel.NodeWidth}" />

                    <Label Style="{StaticResource LabelConfigTree}" Text="{x:Static strings:AppResources.TreeNodeHeightSettingLabel}" />
                    <Slider
                        Maximum="150"
                        Minimum="30"
                        Value="{Binding TreeViewModel.NodeHeight}" />
                </VerticalStackLayout>

                <!-- Colors -->
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource LabelConfigTree}" Text="{x:Static strings:AppResources.TreeNodeColorSettingLabel}" />
                    <controls:ColorPicker
                        x:Name="NodeColor"
                        ColorFlowDirection="Horizontal"
                        ColorSpectrumStyle="ShadeToHueStyle"
                        HeightRequest="100"
                        PickedColor="{Binding TreeViewModel.NodeColor}"
                        PickedColorChanged="NodeColor_PickedColorChanged" />

                    <Label Style="{StaticResource LabelConfigTree}" Text="{x:Static strings:AppResources.TreeNodeLabelColorSettingLabel}" />
                    <controls:ColorPicker
                        x:Name="NodeTextColor"
                        ColorFlowDirection="Horizontal"
                        ColorSpectrumStyle="ShadeToHueStyle"
                        HeightRequest="100"
                        PickedColor="{Binding TreeViewModel.NodeTextColor}"
                        PickedColorChanged="NodeTextColor_PickedColorChanged" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
